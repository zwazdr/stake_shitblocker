{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.3.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://stake.com/*",
    "https://*.stake.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://stake.com/*",
        "https://*.stake.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html"
  }
}